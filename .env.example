# Environment Configuration Example
# Copy this file to .env and update values as needed
#
# The frontend is deferred (see specs/tasks.md Phase 6), so there is no UI
# section here yet - these only affect the engine defaults and AI training.

# Game Configuration
POKER_SMALL_BLIND=1
POKER_BIG_BLIND=2
POKER_INITIAL_STACK=1000

# AI Configuration
POKER_AI_DIFFICULTY=ADVANCED
POKER_RL_LEARNING_RATE=0.001
POKER_RL_BATCH_SIZE=32
POKER_RL_BUFFER_SIZE=10000

# Development
DEBUG=False
LOG_LEVEL=INFO
